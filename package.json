{
  "name": "notion-style-dictionary-tokens",
  "version": "1.0.0",
  "type": "module",
  "description": "Sync design tokens from Notion with Style Dictionary",
  "main": "build.js",
  "scripts": {
    "sync": "node fetch-tokens.js",
    "push": "node push-tokens.js",
    "build": "node build.js",
    "sync:build": "npm run sync && npm run build",
    "watch": "nodemon --watch tokens -e json --exec npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sturobson/Style-Dictionary-Starter.git"
  },
  "keywords": [
    "design-tokens",
    "style-dictionary",
    "notion"
  ],
  "author": "Stuart Robson",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/sturobson/Style-Dictionary-Starter/issues"
  },
  "homepage": "https://github.com/sturobson/Style-Dictionary-Starter#readme",
  "devDependencies": {
    "@notionhq/client": "^2.2.15",
    "style-dictionary": "^4.1.4",
    "nodemon": "^3.0.0",
    "dotenv": "^16.3.1"
  }
}
