{
  "font": {
    "family": {
      "base": {
        "$value": "Arial, sans-serif",
        "$type": "font"
      },
      "code": {
        "$value": "Consolas, monospace",
        "$type": "font"
      }
    },
    "size": {
      "100": {
        "$value": "0.75rem",
        "$type": "dimension"
      },
      "200": {
        "$value": "0.875rem",
        "$type": "dimension"
      },
      "300": {
        "$value": "1rem",
        "$type": "dimension"
      },
      "400": {
        "$value": "1.125rem",
        "$type": "dimension"
      },
      "500": {
        "$value": "1.25rem",
        "$type": "dimension"
      },
      "600": {
        "$value": "1.5rem",
        "$type": "dimension"
      },
      "700": {
        "$value": "1.75rem",
        "$type": "dimension"
      },
      "800": {
        "$value": "2rem",
        "$type": "dimension"
      }
    },
    "weight": {
      "bold": {
        "$value": "700",
        "$type": "dimension"
      },
      "book": {
        "$value": "500",
        "$type": "dimension"
      },
      "light": {
        "$value": "200",
        "$type": "dimension"
      }
    }
  }
}
