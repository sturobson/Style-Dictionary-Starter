{
  "font": {
    "family": {
      "primary": {
        "$value": "'Montserrat', sans-serif",
        "$type": "fontFamily"
      },
      "secondary": {
        "$value": "'Lato', sans-serif",
        "$type": "fontFamily"
      }
    },
    "weight": {
      "regular": {
        "$value": "400",
        "$type": "fontWeight"
      },
      "bold": {
        "$value": "600",
        "$type": "fontWeight"
      }
    },
    "size": {
      "small": {
        "$value": "12px",
        "$type": "dimension"
      },
      "medium": {
        "$value": "15px",
        "$type": "dimension"
      },
      "large": {
        "$value": "22px",
        "$type": "dimension"
      }
    }
  }
}
