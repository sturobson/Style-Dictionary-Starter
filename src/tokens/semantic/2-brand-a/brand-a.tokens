{
    "brand-a": {
        "color": {
            "background": {
                "default": {
                    "$value": "{base.neutral.300}",
                    "$type": "color"
                },
                "muted": {
                    "$value": "{base.neutral.700}",
                    "$type": "color"
                }
            },
            "primary": {
                "default": {
                    "$value": "{base.color.red.100}",
                    "$type": "color"
                },
                "hover": {
                    "$value": "{base.color.red.200}",
                    "$type": "color"
                }
            }
        },
        "spacing": {
            "small": {
                "$value": "{base.spacing.200}",
                "$type": "dimension"
            },
            "medium": {
                "$value": "{base.spacing.400}",
                "$type": "dimension"
            },
            "large": {
                "$value": "{base.spacing.800}",
                "$type": "dimension"
            }
        },
        "radius": {
            "small": {
                "$value": "{base.radius.200}",
                "$type": "dimension"
            },
            "large": {
                "$value": "{base.radius.400}",
                "$type": "dimension"
            }
        }
    }
}