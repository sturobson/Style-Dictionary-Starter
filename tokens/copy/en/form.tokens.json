{
  "copy": {
    "form": {
      "input": {
        "email": {
          "label": {
            "$value": "Email address",
            "$type": "string",
            "$extensions": {
              "com.alwaystwisted.microcopy": { "enabled": true }
            }
          },
          "placeholder": {
            "$value": "you@example.com",
            "$type": "string",
            "$extensions": {
              "com.alwaystwisted.microcopy": { "enabled": true }
            }
          },
          "hint": {
            "$value": "We'll never share your email with anyone else",
            "$type": "string",
            "$extensions": {
              "com.alwaystwisted.microcopy": { "enabled": true }
            }
          }
        },
        "password": {
          "label": {
            "$value": "Password",
            "$type": "string",
            "$extensions": {
              "com.alwaystwisted.microcopy": { "enabled": true }
            }
          },
          "placeholder": {
            "$value": "Enter your password",
            "$type": "string",
            "$extensions": {
              "com.alwaystwisted.microcopy": { "enabled": true }
            }
          },
          "hint": {
            "$value": "Must be at least 8 characters",
            "$type": "string",
            "$extensions": {
              "com.alwaystwisted.microcopy": { "enabled": true }
            }
          }
        }
      }
    }
  }
}
