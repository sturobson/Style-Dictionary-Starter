{
  "copy": {
    "form": {
      "input": {
        "email": {
          "label": {
            "$value": "Adresse e-mail",
            "$extensions": {
              "com.alwaystwisted.microcopy": { "enabled": true }
            }
          },
          "placeholder": {
            "$value": "vous@exemple.com",
            "$extensions": {
              "com.alwaystwisted.microcopy": { "enabled": true }
            }
          },
          "hint": {
            "$value": "Nous ne partagerons jamais votre e-mail avec quiconque",
            "$extensions": {
              "com.alwaystwisted.microcopy": { "enabled": true }
            }
          }
        },
        "password": {
          "label": {
            "$value": "Mot de passe",
            "$extensions": {
              "com.alwaystwisted.microcopy": { "enabled": true }
            }
          },
          "placeholder": {
            "$value": "Entrez votre mot de passe",
            "$extensions": {
              "com.alwaystwisted.microcopy": { "enabled": true }
            }
          },
          "hint": {
            "$value": "Doit contenir au moins 8 caractères",
            "$extensions": {
              "com.alwaystwisted.microcopy": { "enabled": true }
            }
          }
        }
      }
    }
  }
}
